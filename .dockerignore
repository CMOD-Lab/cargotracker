# Java / Maven build artifacts
target/
*.class
*.jar
*.war
*.ear

# Maven wrapper (NEVER used in Docker builds - use system mvn)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (excluded for safety)
gradlew
gradlew.bat
gradle/wrapper/
.gradle/

# Version control
.git/
.gitignore
.gitattributes
.github/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Documentation
*.md
LICENSE*
CONTRIBUTING*
README*

# Test files
src/test/

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
*.tmp

# Docker files (avoid recursive copy)
docker-compose*.yml
.dockerignore

# CI/CD
.github/
nightly.yml

# Kubernetes manifests (not needed in image)
cargo-tracker.yml
k8s/
kubernetes/

# Scripts (not needed in image)
scripts/
docs/
ecs/
