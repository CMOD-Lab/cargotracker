# Docker ignore for Eclipse Cargo Tracker (Jakarta EE / Maven)

# Maven build output
target/

# Maven wrapper (never used in Docker builds)
mvnw
mvnw.cmd
.mvn/

# Gradle wrapper (not applicable but excluded for safety)
gradlew
gradlew.bat
gradle/wrapper/

# Version control
.git/
.gitignore
.github/

# IDE files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# OS files
.DS_Store
Thumbs.db

# Documentation
*.md
LICENSE.md
CONTRIBUTING.md

# Test files
src/test/

# Kubernetes / deployment files (not needed in image)
kubernetes/
scripts/
docs/
cargo-tracker.yml

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak
*.swp
